# Public deployment configuration. Leave missing contracts blank.
# 56 = BNB Smart Chain mainnet; 97 = BNB Smart Chain testnet.
NEXT_PUBLIC_CHAIN_ID=56
# pancake = CaBiPancakeToken (direct V2 swaps); gateway = legacy XBTToken.
NEXT_PUBLIC_TRADING_MODE=pancake
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_GATEWAY_ADDRESS=
NEXT_PUBLIC_USDT_ADDRESS=
# 独立领取池 CaBiSignedClaimPool（构造参数 token, signer, owner；不依赖认购合约）。
# 注意：这是「签名自领」主路径，合约的 signer 必须等于下方 CLAIM_SIGNER_PRIVATE_KEY 的地址。
NEXT_PUBLIC_CLAIM_POOL_ADDRESS=
# Optional legacy reward pool (50% / treasury modes); leave blank for the new timed 50% / real-LP 70% claim pool.
NEXT_PUBLIC_REWARD_POOL_ADDRESS=
# Optional PancakeSwap URL; leave blank until token compatibility is confirmed.
NEXT_PUBLIC_SWAP_URL=
NEXT_PUBLIC_RPC_URL=

# Server-only administrator configuration. Never use NEXT_PUBLIC_ for these.
# Run `npm run admin:setup` to generate local credentials and .env.local safely.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Stable server-only key for encrypted shipping details (minimum 32 characters).
# Back up this key with redemption.sqlite; changing it prevents reading old orders.
REDEMPTION_DATA_SECRET=
# Production canonical origin, e.g. https://your-domain.example (no trailing slash).
APP_ORIGIN=
# Optional absolute persistent data directory; defaults outside the project.
CABI_DATA_DIR=
# Server-side redemption config cache. 0 disables caching; default 60000 ms, max 300000 ms.
REDEMPTION_CONFIG_CACHE_MS=60000

# Optional community demo seed. DEMO ONLY — never put real user data here.
# Only imported when community.sqlite is empty (admins also seed when the admin table is empty).
# Format: a JSON array of members, or an object { official, admins, members }.
# Example (single quotes keep the JSON intact in .env):
# CABI_COMMUNITY_SEED='[{"address":"0x0000000000000000000000000000000000000001","name":"演示成员"}]'
# CABI_COMMUNITY_SEED='{"official":"0x0000000000000000000000000000000000000002","admins":[{"address":"0x0000000000000000000000000000000000000001","name":"演示管理员"}],"members":[{"address":"0x0000000000000000000000000000000000000003","name":"演示成员"}]}'
# Marks one address as the protected official account (members only).
# CABI_OFFICIAL_ADDRESS=0x0000000000000000000000000000000000000002
# Full example file: deploy/seed-community.example.json

# Optional dashboard warning target. Public address only; never a private key.
# NEXT_PUBLIC_KEEPER_ADDRESS=
# Warn when the keeper BNB balance is below this value (default 0.01).
# NEXT_PUBLIC_KEEPER_MIN_BNB=0.01

# Optional pool-burn keeper process ONLY. Do not expose these to the browser.
# Inject a dedicated low-balance keeper key via the scheduler environment.
# The script does not load .env.local or read any private-key file.
# POOL_BURN_KEEPER_PRIVATE_KEY=
# POOL_BURN_RPC_URL=
# POOL_BURN_MAX_GAS_PRICE_GWEI=5

# 领取池额度写入（独立进程，绝不要放进 Web 服务或 NEXT_PUBLIC_）：
# 只通过命令行环境变量注入 owner 私钥，脚本不会读取 .env.local。
# CLAIM_POOL_OWNER_PRIVATE_KEY=
# CLAIM_POOL_ADDRESS=
# RPC_URL=
# CHAIN_ID=56
# MAX_GAS_LIMIT=5000000

# 签名自领服务（仅服务器端，绝不要写成 NEXT_PUBLIC_）。
# 该私钥只用于签发 EIP-712 领取授权，不是 owner，不能转走池内资金。
# 生成新密钥：node -e "const {generatePrivateKey}=require('viem/accounts');console.log(generatePrivateKey())"
# 部署合约时把该地址作为 signer；换 signer 后必须同步更新此值并重启服务。
# 缺失时 /api/claim/authorization 返回「未配置签名服务」，前端领取按钮禁用。
# CLAIM_SIGNER_PRIVATE_KEY=
# 授权有效期（秒），默认 600，可配 60–3600。
# CLAIM_AUTH_TTL_SECONDS=600
# 同一地址每分钟最多签发次数，默认 5。
# CLAIM_AUTH_RATE_LIMIT=5
