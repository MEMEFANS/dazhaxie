# Caddy 反代示例：自动 HTTPS、HSTS，应用只监听 127.0.0.1:3000。
# 使用前替换 example.com 与管理员出口 IP。
{
	email admin@example.com
}

example.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# 可选：只允许指定 IP 访问后台；启用时取消下面三行注释并改成你的出口 IP/网段。
	# @admin_blocked {
	# 	path /admin*
	# 	not remote_ip 203.0.113.10/32
	# }
	# respond @admin_blocked 403

	# Run node deploy/precompress-static.mjs before publishing. Hashed assets
	# bypass Node; precompressed br/gzip files retain the original MIME type.
	handle /_next/static/* {
		uri strip_prefix /_next
		root * /opt/cabi/.next
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed br gzip
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3000 {
			# HTML、API 与后台遵循 Next.js 的 no-store，避免旧合约配置被缓存。
			header_up X-Forwarded-Proto {scheme}
		}
	}
}

# 初次应用 no-store 时清理 CDN 中残留的 HTML 和 _rsc 变体。
